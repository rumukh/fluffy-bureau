 "start": "P0",
 "lines": [
  {
   "id": "P-TITLE",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Первый день стажёра",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P0-01",
   "rev": 2,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Ой, у нас пополнение! Сейчас запишу.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P0-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Кто ты? Выбери себя.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P0-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Как тебя зовут?",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P0-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Какого цвета твой шарфик?",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P0-05",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Записала, {имя}! Не забуду… кажется.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Добро пожаловать в Пушистое бюро, {имя}!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "P1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Я Шерлок Хвостс. Когда думаю, пускаю пузыри.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Сыщик замечает мелочи. Давай потренируемся!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "P1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Нажми на то, что светится.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-09",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "А это лампа смелости.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-10",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Станет неуютно — нажми её.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-11",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Будет светло, тепло и спокойно.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "P1-12",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Видишь? Лампа всегда рядом.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "P2-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Ой! Где мои очки? Ничего не вижу!",
   "voiced": true,
   "delivery": "worried"
  },
  {
   "id": "P2-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Твоё первое дело, {имя}. Найдём очки!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "P2-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "В Блокноте три места. Где же очки?",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Крестик — точно нет. Галочка — точно да.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-05",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Вопрос — пока не знаю. Это тоже честно.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-AX-shelf",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Полка",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-AX-teapot",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Чайник",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-B03",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Зеркало",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-06",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "На полке только книги. Очков нет.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-07",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Поставь крестик у полки.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-08",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "В чайнике тёплый чай. Очков нет.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-09",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "В зеркале Ватсони. На голове что-то блестит!",
   "voiced": true,
   "delivery": "excited"
  },
  {
   "id": "P2-10",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Всё проверено? Скажи Ватсони свою догадку.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-11",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "На голове? Ой… и правда! Вот они!",
   "voiced": true,
   "delivery": "excited"
  },
  {
   "id": "P2-12",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Спасибо, {имя}! Я бы искала до вечера.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-13",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Элементарно, пушинка!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "P3-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Держи телефон-ракушку.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P3-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Трудно — позвони Ватсони. Она подскажет.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P3-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Подскажу! Если не забуду…",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P3-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Нужен отдых? Нажми паузу. Мы всё запомним.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "P3-05",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Письмо от мэра Пудинга. Читаю…",
   "voiced": true,
   "delivery": "thinking"
  },
  {
   "id": "P3-06",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Срочно! Пропал черничный пирог!",
   "voiced": true,
   "delivery": "excited"
  },
  {
   "id": "P3-07",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Настоящее дело, {имя}! Держи значок стажёра.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P3-08",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Нажми на Пироговую улицу. Бежим!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "P3-B01",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Пироговая улица",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-AX-where",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Где?",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-AX-head",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Голова Ватсони",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-CL-shelf",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Полка: очков нет",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-CL-teapot",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Чайник: очков нет",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-CL-mirror",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Зеркало: на голове что-то блестит",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P2-14",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Отличная попытка! Запишем и подумаем.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "P2-15",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Мы ещё не смотрели в зеркало.",
   "voiced": true,
   "delivery": "thinking"
  },
  {
   "id": "P2-16",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Что блестело в зеркале?",
   "voiced": true,
   "delivery": "thinking"
  },
  {
   "id": "P1-B01",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Лупа",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-05",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Это лупа. Она делает мелочи большими.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-B02",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Блокнот сыщика",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-06",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Это Блокнот сыщика. Там живут наши догадки.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-B03",
   "rev": 1,
   "kind": "label",
   "speaker": "narrator",
   "text": "Почтовый жук",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-07",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "khvosts",
   "text": "Заводной почтовый жук. Он носит письма.",
   "voiced": true,
   "delivery": "neutral"
  },
  {
   "id": "P1-08",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Не слышно? Нажми ушко. Я повторю.",
   "voiced": true,
   "delivery": "neutral"
  }
 ],
