 "start": null,
 "lines": [
  {
   "id": "CZ-pudding-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pudding",
   "text": "Чаепитие? Обожаю! Я принесу семечки.",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-pudding-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pudding",
   "text": "Знаешь, почему у меня такие щёки?",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pudding-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pudding",
   "text": "Хомяки носят запасы в щеках. Очень удобно!",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pudding-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pudding",
   "text": "Однажды я принёс так целую горсть подсолнуха.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pudding-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pudding",
   "text": "Потом чихнул, и семечки разлетелись по площади!",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pudding-S1-05",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pudding",
   "text": "С тех пор на площади растут подсолнухи.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-tyopa-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "tyopa",
   "text": "Иду! Возьму кусочек черничного мыла в подарок.",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-tyopa-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "tyopa",
   "text": "Мыло я варю с детства. Бабушка научила.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-tyopa-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "tyopa",
   "text": "Сначала у меня выходили одни пузыри.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-tyopa-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "tyopa",
   "text": "Пузыри улетали прямо в окна соседей.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-tyopa-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "tyopa",
   "text": "Соседи не сердились. Говорили: пахнет праздником!",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-fitilyok-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "fitilyok",
   "text": "Чай вечером? Я посвечу над столом!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-fitilyok-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "fitilyok",
   "text": "Я зажигаю фонари на Пироговой улице.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-fitilyok-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "fitilyok",
   "text": "Каждый вечер облетаю все до одного.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-fitilyok-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "fitilyok",
   "text": "Один фонарь всегда гаснет раньше всех.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-fitilyok-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "fitilyok",
   "text": "Я зову его Соней. Он просто рано ложится.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-kartofan-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "kartofan",
   "text": "Иду! Принесу свежей морковки к чаю.",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-kartofan-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "kartofan",
   "text": "Я сажаю огород на ощупь и по запаху.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-kartofan-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "kartofan",
   "text": "Морковь пахнет сладко, а укроп — свежо.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-kartofan-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "kartofan",
   "text": "Однажды я посадил тюльпаны вместо лука.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-kartofan-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "kartofan",
   "text": "Весной весь огород расцвёл. Было очень красиво!",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-stella-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "stella",
   "text": "Чай? Лечу! Захвачу свежую газету.",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-stella-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "stella",
   "text": "Я знаю каждый почтовый ящик в Пушистино.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-stella-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "stella",
   "text": "Самое трудное письмо пришло без адреса.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-stella-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "stella",
   "text": "На конверте был только рисунок: дом с красной крышей.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-stella-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "stella",
   "text": "Я облетела весь город и нашла этот дом!",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-mouse-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "mouse",
   "text": "Нам можно на чай? Мы тихонько!",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-mouse-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "mouse",
   "text": "Нас в семье очень много мышат.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-mouse-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "mouse",
   "text": "Мы спим в одной большой кровати.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-mouse-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "mouse",
   "text": "Кто ворочается, тот рассказывает сказку.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-mouse-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "mouse",
   "text": "Поэтому сказки у нас каждую ночь!",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-damka-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "damka",
   "text": "С удовольствием! Только сначала проверю маяк.",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-damka-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "damka",
   "text": "Медовый маяк построила ещё моя прабабушка.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-damka-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "damka",
   "text": "Бобры умеют строить из веток и ила.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-damka-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "damka",
   "text": "А я научилась ещё и чинить фонари.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-damka-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "damka",
   "text": "Свет маяка видно с самого дальнего берега.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pukhlik-INV",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pukhlik",
   "text": "Чай? Только вечерний. Днём я сплю.",
   "voiced": true,
   "delivery": "cheerful"
  },
  {
   "id": "CZ-pukhlik-S1-01",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pukhlik",
   "text": "Я учусь дежурить ночью, как настоящий сыщик.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pukhlik-S1-02",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pukhlik",
   "text": "Ночью город тихий, а звёзды яркие.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pukhlik-S1-03",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pukhlik",
   "text": "Я считаю огоньки в окнах. Так не хочется спать.",
   "voiced": true,
   "delivery": "warm"
  },
  {
   "id": "CZ-pukhlik-S1-04",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "pukhlik",
   "text": "Гаснет огонёк — я шепчу: спокойной ночи.",
   "voiced": true,
   "delivery": "warm"
  },
  {
