  },
  {
   "id": "CZ-RETURNED",
   "rev": 1,
   "kind": "dialogue",
   "speaker": "watsony",
   "text": "Вернули. Всё снова в копилке.",
   "voiced": true,
   "delivery": "warm"
  },
  {
